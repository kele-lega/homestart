{
  "name": "homestart",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check && svelte-check --tsconfig ./tsconfig.svelte.json --fail-on-warnings",
    "build": "npm run check && astro build",
    "preview": "astro preview",
    "start": "node ./dist/server/entry.mjs",
    "test": "vitest run",
    "test:e2e": "npm run e2e:build && playwright test",
    "e2e:build": "astro build --outDir dist/e2e",
    "fetch-icons": "node scripts/fetch-icons.mjs",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@astrojs/node": "11.1.6",
    "@astrojs/svelte": "9.0.1",
    "astro": "7.3.5",
    "ical.js": "2.2.1",
    "svelte": "5.57.1",
    "tyme4ts": "1.5.2",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@vitest/coverage-v8": "5.0.2",
    "svelte-check": "4.7.6",
    "typescript": "6.0.3",
    "vitest": "5.0.2"
  }
}
