# 复制这个文件为 .env 并填入真实值。.env 已经在 .gitignore 里，不会被提交。
# 完整说明见 docs/DEPLOYMENT.md、docs/STEAM.md、docs/AUTH.md

# Steam 模块（可选）。留空则 Steam 卡片显示"未配置"提示，不影响其他功能
STEAM_API_KEY=

# 登录系统的初始管理员（可选）。只在账号表为空时生效，建号后可以删掉这两行
INITIAL_ADMIN_USER=
INITIAL_ADMIN_PASSWORD=

# 反代做认证并注入 X-Authenticated-User 时设成 1；只用内置登录就留空（见 docs/DEPLOYMENT.md）
TRUST_PROXY_USER=

# 本地开发时如果没有反向代理注入身份头，可以设置这个来模拟已登录用户。
# 生产环境绝不能设置
HOME_DEV_USER=

# 注册与第三方登录（都可选，没配齐的功能直接不开，见 docs/AUTH.md）
# 本站对外地址，拼第三方登录的回调地址：<SITE_ORIGIN>/api/auth/oauth/<github|google>/callback
SITE_ORIGIN=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 邮箱注册、找回密码、改邮箱用 Resend 发验证码；MAIL_FROM 的域名要先在 Resend 验证
RESEND_API_KEY=
MAIL_FROM=
# Cloudflare Turnstile 人机验证；不配就只靠按 IP 限流
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# 全站每天最多新注册几个账号（默认 50）、最多发几封信（默认 90，Resend 免费额度每天 100）
SIGNUP_DAILY_LIMIT=
MAIL_DAILY_LIMIT=
