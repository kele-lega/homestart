---
import { listAnnouncements } from '../../adapters/announcements';
import { getAuthService } from '../../adapters/auth/service';
import type { SiteConfig } from '../../core/site';
import Announcements from '../../widgets/toolbar/Announcements.svelte';

/**
 * 顶上正中的三样：告示、设置、自己。都按登录状态在服务端渲染：
 * 「设置」直接进设置页（明暗切换在首页右下角，见 InkPage 的 .hue）；
 * 没登录是「登录」两个字；登录后是名字的第一个字，直接进个人中心（资料、安全、设备、管理都在那里）。
 * 「管理员」字样只在管理员的页面里有
 */
interface Props {
  readonly site: SiteConfig;
}

const { site } = Astro.props;
const auth = Astro.locals.auth;
const service = auth ? await getAuthService() : undefined;
const account = auth && service?.account(auth.userId);
const name = account ? (account.displayName ?? account.username) : undefined;
const admin = account?.role === 'admin';
const announcements = await listAnnouncements();
const initial = name ? (Array.from(name.trim())[0]?.toUpperCase() ?? '我') : undefined;
---

<nav class="tools" aria-label="工具" data-account data-user={account?.username ?? ''}>
  <Announcements client:idle announcements={announcements} admin={admin} timeZone={site.timezone} label="告示" />
  <a class="tool" href="/settings">设置</a>
  {
    account && name ? (
      <a class="tool me" href="/account" aria-label={`个人中心（${name}）`}>
        {initial}
      </a>
    ) : (
      <a class="tool" href="/login">
        登录
      </a>
    )
  }
</nav>

<script>
  import './tools';
</script>
