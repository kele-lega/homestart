---
import type { SubPage } from '../pages';

/**
 * 首页底下四个入口的「器物」图标：淡墨线描，各带一点朱砂，平时自己慢慢动，悬停时动得明显一点。
 * - 月令：日晷，斜放的晷面上晷影绕着朱砂的晷心来回扫
 * - 目录：一编竹简（每根上几笔字），系绳上挂的朱砂签子轻轻晃，悬停时竹简摊开一点
 * - 游艺：风筝，在风里浮沉，尾巴上的朱砂结跟着摆
 * - 跋：毛笔蘸砚，笔尖是朱笔，蘸一下墨池漾开一圈
 * 线条、颜色、动画都在 ink.css 的「器物图标」一节；减少动态效果时全局规则会停掉动画。
 * 转场时它和子页页眉的印章共用一个 view-transition-name（router.ts 的 sealOf），器物化成印章
 */
interface Props {
  readonly name: SubPage;
}

const { name } = Astro.props;

// 日晷刻度：十二时辰（画在正圆上，外面整组斜着压扁成晷面）
const TICKS = Array.from({ length: 12 }, (_, i) => {
  const a = (i / 12) * 2 * Math.PI;
  const r = (n: number) => Math.round(n * 100) / 100;
  return `M${r(20 + Math.sin(a) * 9.6)} ${r(16 - Math.cos(a) * 9.6)} L${r(20 + Math.sin(a) * 11.4)} ${r(16 - Math.cos(a) * 11.4)}`;
}).join(' ');

const SLIPS = [7.4, 11.6, 15.8, 20, 24.2, 28.4];
---

<svg class="qi" data-qi={name} viewBox="0 0 40 40" aria-hidden="true">
  {
    name === 'cal' && (
      <>
        <path d="M11 37.4 H29 L27 31.4 H13 Z" />
        <path d="M20 31.4 V24.4" />
        <g transform="rotate(-22 20 16) scale(1 .62) translate(0 9.8)">
          <circle cx="20" cy="16" r="12.4" />
          <circle cx="20" cy="16" r="9" class="dan-q" />
          <path d={TICKS} class="ke" />
          <path class="ying" d="M20 16 L20 7.6" />
        </g>
        <path class="zhen" d="M17.2 22.4 L24.6 4.6" />
        <circle class="dan" cx="20.2" cy="15.6" r="1.6" />
      </>
    )
  }
  {
    name === 'dir' && (
      <>
        <g class="jian">
          {SLIPS.map((x, i) => (
            <g style={`--i: ${i}`}>
              <rect x={x} y={8 + (i % 2) * 0.8} width="2.6" height={23.4 - (i % 3) * 0.6} rx=".5" />
              <path class="zi" d={`M${x + 1.3} ${12 + (i % 2) * 1.2} v1.4 M${x + 1.3} ${17 + (i % 3)} v1.8 M${x + 1.3} ${22.6 + (i % 2)} v1.2`} />
            </g>
          ))}
        </g>
        <path class="sheng" d="M4.6 13.6 C10 12.6 18 14.6 26 13.4 C30 12.8 32.6 13 35 13.8 M4.6 27.4 C10 26.4 18 28.6 26 27.4 C30 26.8 32.6 27 35 27.8" />
        <g class="qian">
          <path d="M4.6 13.6 L4.2 19.6" />
          <rect class="dan" x="2.4" y="19.4" width="3.8" height="6.4" rx=".6" />
        </g>
      </>
    )
  }
  {
    name === 'play' && (
      <>
        <path class="xian" d="M20 15.4 C14 22 8 30 3 38.6" />
        <g class="yuan">
          <path d="M20 4.6 L29.4 15 L20 27 L10.6 15 Z" />
          <path d="M20 4.6 V27 M10.6 15 Q20 12.4 29.4 15" class="gu" />
          <g class="wei">
            <path d="M20 27 C18 29.6 22 31.6 20 34.4 C18.2 36.8 21 38.4 19.6 39.6" />
            <path class="dan" d="M18.2 30.2 L20 31.2 L21.8 30.2 L21.8 32.4 L20 31.4 L18.2 32.4 Z" />
            <path class="dan" d="M18.8 35.6 L20.2 36.4 L21.6 35.6 L21.6 37.4 L20.2 36.6 L18.8 37.4 Z" />
          </g>
        </g>
      </>
    )
  }
  {
    name === 'site' && (
      <>
        <ellipse cx="20" cy="32.4" rx="13.4" ry="4.4" />
        <path d="M6.6 32.6 V34.4 C6.6 36.8 12.6 38.8 20 38.8 C27.4 38.8 33.4 36.8 33.4 34.4 V32.6" />
        <ellipse class="chi" cx="17" cy="32.2" rx="6.4" ry="1.9" />
        <ellipse class="yi" cx="17" cy="32.2" rx="6.4" ry="1.9" />
        <g class="bi">
          <circle cx="32.2" cy="4.2" r="1.3" />
          <path class="gan" d="M31.4 5.4 L22.4 21" />
          <path d="M23.4 19.4 L21.2 18.2" />
          <path class="dan" d="M22.2 19 C20.4 21 19 24.2 18.2 28.4 C20.6 26 22.6 23.4 24.2 20.8 Z" />
        </g>
      </>
    )
  }
</svg>
