---
import BaseLayout from '../layouts/BaseLayout.astro';
import Page from '../zones/Page.astro';
import ConfigErrorView from '../zones/ConfigErrorView.astro';
import { ConfigError } from '../core/config-error';
import { loadConfig } from '../core/runtime';
import { reportWarningsOnce } from '../core/warnings';

const FALLBACK_SITE = { title: '配置有误', lang: 'zh-CN', favicon: '/favicon.ico' } as const;

// 配置有误时显示说明页而不是空白 500；其它异常照常抛出
const result = await loadConfig().then(
  (config) => ({ config, error: undefined }),
  (error: unknown) => {
    if (error instanceof ConfigError) return { config: undefined, error };
    throw error;
  },
);

if (result.config) {
  reportWarningsOnce(result.config, (message) => Astro.logger.warn(message));
} else {
  Astro.logger.error(result.error.message);
  Astro.response.status = 500;
}
---

{
  result.config ? (
    <BaseLayout site={result.config.site}>
      <Page config={result.config} />
    </BaseLayout>
  ) : (
    <BaseLayout site={FALLBACK_SITE}>
      <ConfigErrorView error={result.error} />
    </BaseLayout>
  )
}
