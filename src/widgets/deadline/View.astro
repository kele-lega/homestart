---
import FrameHead from '../../components/FrameHead.astro';
import type { WidgetViewProps } from '../../core/widget';
import Live from './Live.astro';
import type { DeadlineOptions } from './widget';

type Props = WidgetViewProps<DeadlineOptions>;

const { id, heading } = Astro.props;
// 骨架的行数：island 到达前大致占住列表的高度
const SKELETON_ROWS = 3;
---

{heading && <FrameHead heading={heading} />}
<div class="deadline">
  <Live server:defer id={id}>
    <Fragment slot="fallback">
      <ul class="dl-list" role="list" aria-hidden="true">
        {
          Array.from({ length: SKELETON_ROWS }, () => (
            <li class="dl">
              <span class="dl-left bone num" />
              <span class="bone name" />
              <span class="bone date" />
            </li>
          ))
        }
      </ul>
      <span class="visually-hidden">Deadline 加载中</span>
    </Fragment>
  </Live>
</div>

<style>
  /*
   * 条目之间是带剪刀的撕线。一条一行：左边大号的剩余天数，中间事项名，日期靠右；
   * 最近几天的一条数字标红、事项名后面有红笔批注。事项名太长时截断，批注和日期照常显示。
   * Live.astro 的内容用 :global 选中；骨架用同样的行结构，岛屿到达前后位置不变
   */
  .deadline :global(.dl-list) {
    display: grid;
    /* 各行共用一套列宽：剩余天数到三位数时整列一起变宽，数字仍然对齐 */
    grid-template-columns: minmax(3.25rem, max-content) minmax(0, 1fr) max-content;
    column-gap: 0.75rem;
    padding: 0;
    list-style: none;
  }

  .deadline :global(.dl) {
    position: relative;
    display: grid;
    grid-column: 1 / -1;
    grid-template-columns: subgrid;
    align-items: baseline;
    padding-block: 0.4375rem;
  }

  .deadline :global(.dl + .dl) {
    border-top: 1.5px dashed var(--rule);
  }

  /* 剪刀压在撕线的左端；Segoe UI Symbol 里的剪刀是单色的，不会被系统换成彩色 emoji */
  .deadline :global(.dl + .dl)::before {
    content: '\2702\FE0E';
    position: absolute;
    inset-block-start: -0.5625rem;
    inset-inline-start: -0.125rem;
    padding-inline-end: 0.375rem;
    font: var(--text-sm) / 1 'Segoe UI Symbol', sans-serif;
    color: var(--ink-3);
    background: var(--paper);
  }

  .deadline :global(.dl-left) {
    font: var(--text-sm) / 1 var(--label);
    color: var(--ink-2);
    white-space: nowrap;
  }

  .deadline :global(.dl-left b) {
    margin-inline-end: 0.1875rem;
    font: 400 1.875rem / 1 var(--serif);
    color: var(--ink);
  }

  .deadline :global(.dl[data-urgent] .dl-left b) {
    color: var(--red);
  }

  /* 事项名占满中间一栏，放不下省略号收尾；批注不缩，总能看到 */
  .deadline :global(.dl-name) {
    display: flex;
    align-items: baseline;
    min-inline-size: 0;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .deadline :global(.dl-title) {
    min-inline-size: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
  }

  .deadline :global(.dl-note) {
    flex: none;
    margin-inline-start: 0.5rem;
    font: 400 var(--text-lg) / 1 var(--pen);
    color: var(--red);
    white-space: nowrap;
    rotate: -4deg;
  }

  .deadline :global(.dl-date) {
    font: var(--text-xs) / 1.4 var(--num);
    color: var(--ink-3);
    white-space: nowrap;
  }

  /* 骨架：数字一块、事项名和日期各一条，不做闪烁动画 */
  .bone {
    display: block;
    align-self: center;
    background: var(--skeleton);
  }

  .bone.num {
    inline-size: 2.75rem;
    block-size: 1.75rem;
  }

  .bone.name {
    inline-size: 70%;
    block-size: 0.875rem;
  }

  .bone.date {
    inline-size: 4rem;
    block-size: 0.75rem;
  }
</style>
