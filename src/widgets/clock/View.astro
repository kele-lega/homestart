---
import type { WidgetViewProps } from '../../core/widget';
import { cnDayInfo } from '../../lib/cn-calendar';
import { GREETINGS, formatClock } from './format';
import type { ClockOptions } from './widget';

type Props = WidgetViewProps<ClockOptions>;

const { options, site } = Astro.props;
// 首屏直接渲染服务端时间，脚本加载后接管刷新，不会出现空白或跳动
const now = new Date();
const parts = formatClock(now, site.timezone, site.lang);
const lunar = cnDayInfo(parts.year, parts.month, parts.day);
// 例如“八月十九”；逢节日或节气再补一个：“八月十五 · 中秋”
const lunarText = [`${lunar.lunarMonth}${lunar.lunarDay}`, lunar.festival ?? lunar.term].filter(Boolean).join(' · ');
---

<div
  class="clock"
  data-clock
  data-timezone={site.timezone}
  data-lang={site.lang}
  data-seconds={options.seconds ? '' : undefined}
>
  <time class="time" datetime={now.toISOString()}>
    <span data-part="hours">{parts.hours}</span>:<span data-part="minutes">{parts.minutes}</span>
    {
      options.seconds && (
        <span class="seconds">
          :<span data-part="seconds">{parts.seconds}</span>
        </span>
      )
    }
  </time>
  <!-- 标签之间带换行的空白在构建时会被删掉，空格要显式写出来 -->
  <p class="date">
    <span data-part="date">{parts.date}</span>{' '}<span data-part="weekday">{parts.weekday}</span>{` · ${lunarText}`}
  </p>
  {
    options.greeting && (
      <p class="greet">
        <span data-part="greeting">{GREETINGS[parts.period]}</span>
        {options.name && `，${options.name}`}
      </p>
    )
  }
</div>

<script>
  import './clock';
</script>

<style>
  .clock {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 1rem;
    align-items: center;
  }

  /* 数字等宽，每分钟跳字时整行不晃 */
  .time {
    display: flex;
    grid-row: span 2;
    align-items: baseline;
    font: 400 4rem/1 var(--serif);
    font-variant-numeric: tabular-nums;
  }

  .seconds {
    font-size: 0.42em;
    color: var(--ink-3);
  }

  .date {
    align-self: end;
    font: var(--text-base) / 1.4 var(--label);
    color: var(--ink-2);
  }

  /* 红笔手写的问候，微微歪一点 */
  .greet {
    align-self: start;
    font: 1.25rem/1.3 var(--pen);
    color: var(--red);
    rotate: -2deg;
  }

  /* 不显示问候语时只剩一行，日期与时间居中对齐 */
  .clock:not(:has(.greet)) .time {
    grid-row: auto;
  }

  .clock:not(:has(.greet)) .date {
    align-self: center;
  }

  @media (width <= 48rem) {
    .clock {
      grid-template-columns: auto;
    }

    .time {
      grid-row: auto;
      font-size: 3.125rem;
    }

    .date {
      margin-top: 0.375rem;
    }

    .greet {
      font-size: 1.0625rem;
    }
  }
</style>
