---
import { listAnnouncements } from '../../adapters/announcements';
import { getAuthService } from '../../adapters/auth/service';
import type { WidgetViewProps } from '../../core/widget';
import Avatar from '../../components/Avatar.svelte';
import { formatWhen } from '../../lib/account-view';
import { CHEVRON, GEAR, LOCK, MONITOR, PEOPLE, PERSON, SIGN_OUT } from '../../lib/icons';
import Announcements from './Announcements.svelte';
import type { ToolbarOptions } from './widget';

type Props = WidgetViewProps<ToolbarOptions>;

const { site } = Astro.props;
/**
 * 头像、面板里的摘要都按站内登录直接渲染，不等脚本：翻页快照里就是最终的样子，不会先闪一下「登录」。
 * 账号在别处被删了（会话随之失效）时 account 为空，按没登录处理
 */
const auth = Astro.locals.auth;
const service = auth ? await getAuthService() : undefined;
const account = auth && service?.account(auth.userId);
const name = account ? (account.displayName ?? account.username) : undefined;
const summary =
  auth && account && service
    ? {
        lastLogin: account.previousLogin ? formatWhen(account.previousLogin.at, site.timezone) : '这是第一次',
        devices: service.listSessions(auth.userId).length,
      }
    : undefined;
const announcements = await listAnnouncements();
const isAdmin = auth?.role === 'admin';
const current = Astro.url.pathname === '/settings';

const MENU = [
  { href: '/account#profile', label: '个人资料', icon: PERSON },
  { href: '/account#password', label: '修改密码', icon: LOCK },
  { href: '/account#sessions', label: '登录设备', icon: MONITOR },
  ...(isAdmin ? [{ href: '/account#users', label: '账号管理', icon: PEOPLE }] : []),
];
---

<div class="toolbar" data-toolbar>
  <div class="account" data-account data-user={account?.username ?? ''}>
    {
      account && name ? (
        <a class="circle avatar" href="/account" aria-label={`个人中心（${name}）`}>
          <Avatar avatar={account.avatar} />
        </a>
      ) : (
        <a class="circle avatar" href="/login" data-anonymous>
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            {PERSON.map((d) => <path d={d} />)}
          </svg>
          <span class="visually-hidden">登录</span>
        </a>
      )
    }
    <!-- 悬停在头像上时展开；键盘 Tab 到头像上也展开，再按 Tab 走进面板。面板里的内容在个人中心都有 -->
    <div class="panel">
      <div class="card">
        {
          account && name && summary ? (
            <>
              <p class="who">
                <span class="name">{name}</span>
                {account.role === 'admin' && <span class="badge">管理员</span>}
              </p>
              {account.displayName && <p class="handle">@{account.username}</p>}
              <dl class="stats">
                <div>
                  <dt>上次登录</dt>
                  <dd>{summary.lastLogin}</dd>
                </div>
                <div>
                  <dt>登录设备</dt>
                  <dd>{summary.devices} 台</dd>
                </div>
              </dl>
              <ul class="menu" role="list">
                {MENU.map((item) => (
                  <li>
                    <a class="row petal-row" href={item.href}>
                      <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                        {item.icon.map((d) => <path d={d} />)}
                      </svg>
                      <span class="label">{item.label}</span>
                      <svg class="chevron" viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
                        {CHEVRON.map((d) => <path d={d} />)}
                      </svg>
                    </a>
                  </li>
                ))}
              </ul>
              <button type="button" class="row petal-row sign-out" data-sign-out>
                <svg viewBox="0 0 16 16" width="15" height="15" aria-hidden="true">
                  {SIGN_OUT.map((d) => <path d={d} />)}
                </svg>
                <span class="label" data-sign-out-label>退出登录</span>
              </button>
            </>
          ) : (
            <>
              <p class="who">
                <span class="name">还没登录</span>
              </p>
              <p class="hint">登录后天气地区、搜索引擎、网站导航、日历订阅这些设置跟着账号走。</p>
              <a class="login" href="/login">去登录</a>
            </>
          )
        }
      </div>
    </div>
  </div>

  <a class="circle" href="/settings" aria-label="设置" aria-current={current ? 'page' : undefined} data-gear>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
      {GEAR.map((d) => <path d={d} />)}
    </svg>
  </a>

  <Announcements client:load announcements={announcements} admin={isAdmin} timeZone={site.timezone} />
</div>

<script>
  import './toolbar';
</script>

<style>
  /* 三个一样大的圆排在页头最右边；Announcements.svelte 里的按钮也用 .circle，所以用 :global 选中 */
  .toolbar {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.625rem;
  }

  .toolbar :global(.circle) {
    position: relative;
    display: grid;
    place-items: center;
    inline-size: 2.25rem;
    block-size: 2.25rem;
    padding: 0;
    color: var(--ink-2);
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: 50%;
    transition:
      color var(--dur-hover) var(--ease-out),
      border-color var(--dur-hover) var(--ease-out),
      background-color var(--dur-hover) var(--ease-out);
  }

  .toolbar :global(.circle svg),
  .row svg {
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  /* 设置和公告悬停只换颜色，不弹出东西；齿轮顺便转一个齿 */
  @media (hover: hover) {
    .toolbar :global(.circle:not(.avatar):hover) {
      color: var(--sakura-deep);
      background: var(--sakura-wash);
      border-color: var(--sakura);
    }

    [data-gear]:hover svg {
      rotate: 45deg;
    }
  }

  [data-gear] svg {
    transition: rotate var(--dur-open) var(--spring);
  }

  [data-gear][aria-current='page'] {
    color: var(--ink);
    border-color: var(--ink-3);
  }

  /*
   * 头像：登录后是自己的头像（上传的图或默认色块图，components/Avatar），没登录是一个人像。
   * 悬停时像 B 站那样：头像放大、往下落，压在展开的面板上沿；面板淡入、往上浮一点。
   * 开合只有一个会动的量：.account 上的 --account-open（注册成数字，能过渡），0 收起、1 展开；
   * 头像的放大、下落和面板的淡入、上浮每一帧都由它算出来，所以两边永远同步，鼠标来回扫、半路折回也不会各走各的。
   * 展开前等 60ms（只扫过去不算悬停），离开后等 0.2 秒再收（指针从头像挪到面板的路上不会断）。
   * --vis 给面板的 visibility，跟着同样的等待切换；收起的面板不可见，也就不会在原地挡住悬停
   */
  @property --account-open {
    syntax: '<number>';
    inherits: true;
    initial-value: 0;
  }

  .account {
    --account-open: 0;
    --open-delay: 60ms;
    --close-delay: 0.2s;
    --vis: hidden;
    --vis-delay: calc(var(--close-delay) + var(--dur-close));

    position: relative;
    z-index: var(--z-popover);
    transition: --account-open var(--dur-close) var(--ease-out) var(--close-delay);
  }

  /* 按了 Esc 的（data-dismissed，见 toolbar.ts）先不展开，指针离开或焦点走开以后恢复 */
  @media (hover: hover) {
    .account:not([data-dismissed]):hover {
      --account-open: 1;
      --vis: visible;
      --vis-delay: var(--open-delay);

      transition: --account-open var(--dur-open) var(--ease-out) var(--open-delay);
    }
  }

  /* 键盘 Tab 到头像上、或者焦点在面板里时也展开，不用等；鼠标点头像直接跳走，不会先展开一下 */
  .account:not([data-dismissed]):has(.avatar:focus-visible),
  .account:not([data-dismissed]):has(.panel:focus-within) {
    --account-open: 1;
    --vis: visible;
    --vis-delay: 0s;

    transition: --account-open var(--dur-open) var(--ease-out);
  }

  /* Esc 是要它马上收起，不等那 0.2 秒 */
  .account[data-dismissed] {
    --close-delay: 0s;
  }

  .avatar {
    z-index: 2;
    scale: calc(1 + var(--account-open) * 0.9);
    translate: 0 calc(var(--account-open) * 1.125rem);
    box-shadow:
      0 0 0 calc(var(--account-open) * 2px) var(--surface),
      0 0 0 calc(var(--account-open) * 2.5px) var(--rule);
  }

  /* 图填满整个圆，圆外那圈描边和展开时的白边是 box-shadow，不会被裁掉 */
  .avatar:not([data-anonymous]) {
    overflow: hidden;
  }

  /* 刚登录：头像从小弹到正常大小。只填 backwards，结束后不接管 scale，悬停照样放大 */
  @media (prefers-reduced-motion: no-preference) {
    :global(html[data-arrival='signed-in']) .avatar {
      animation: avatar-pop 640ms var(--spring) calc(var(--dur-turn) * 0.6) backwards;
    }
  }

  @keyframes avatar-pop {
    from {
      opacity: 0;
      scale: 0.3;
    }
  }

  /*
   * 面板挂在头像正下方。上边一段透明的内边距连着头像，指针往下挪时一直在 .account 里面；
   * 放大的头像压住卡片上沿那道粗线。窄屏头像离右边不远，面板改成右边和工具栏对齐
   */
  .panel {
    --shift-x: -50%;

    position: absolute;
    inset-block-start: 100%;
    inset-inline-start: 50%;
    z-index: 1;
    inline-size: 17rem;
    padding-block-start: 0.5rem;
    visibility: var(--vis);
    opacity: var(--account-open);
    transform: translateX(var(--shift-x));
    translate: 0 calc((1 - var(--account-open)) * -6px);
    transition: visibility 0s linear var(--vis-delay);
  }

  .card {
    display: grid;
    gap: 0.75rem;
    padding: 2rem 0.875rem 0.625rem;
    background: var(--surface);
    border: var(--rule-thin);
    border-block-start: var(--rule-heavy);
    box-shadow: var(--lift);
  }

  .who {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.375rem;
  }

  .name {
    font: 700 var(--text-xl) / 1.3 var(--font-body);
    letter-spacing: 0.06em;
    overflow-wrap: anywhere;
  }

  .badge {
    padding: 0.0625rem 0.375rem;
    font: var(--text-2xs) / 1.5 var(--label);
    color: var(--sakura-deep);
    white-space: nowrap;
    border: 1px solid currentcolor;
    border-radius: 999px;
  }

  .handle,
  .hint {
    margin-block-start: -0.5rem;
    font: var(--text-xs) / 1.5 var(--num);
    color: var(--ink-3);
    text-align: center;
    overflow-wrap: anywhere;
  }

  .hint {
    margin-block-start: 0;
    font-family: var(--label);
  }

  /* 两格摘要：数在上、名目在下，中间一道细竖线 */
  .stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    padding-block: 0.5rem;
    border-block: var(--rule-thin);
  }

  .stats div {
    display: flex;
    flex-direction: column-reverse;
    align-items: center;
    gap: 0.125rem;
    min-inline-size: 0;
    text-align: center;
  }

  .stats div + div {
    border-inline-start: var(--rule-thin);
  }

  .stats dt {
    font: var(--text-2xs) / 1.4 var(--label);
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .stats dd {
    margin: 0;
    font: var(--text-xs) / 1.4 var(--num);
    color: var(--ink);
  }

  /* 一栏一栏的入口：图标、名字、右箭头；悬停时用全站的花瓣高亮（base.css 的 .petal-row） */
  .menu {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    inline-size: 100%;
    padding: 0.5rem 0.625rem 0.5rem 0.875rem;
    font: var(--text-base) / 1.4 var(--font-body);
    color: var(--ink);
    text-align: start;
    background: none;
    border: 0;
  }

  .row svg {
    flex: none;
    color: var(--ink-3);
  }

  .label {
    flex: 1;
  }

  .row:is(:hover, :focus-visible) {
    --lit: 1;
  }

  .row:is(:hover, :focus-visible) svg {
    color: var(--sakura-deep);
  }

  .sign-out {
    padding-block-start: 0.625rem;
    color: var(--ink-2);
    border-block-start: var(--rule-thin);
  }

  .sign-out:is(:hover, :focus-visible),
  .sign-out:is(:hover, :focus-visible) svg {
    color: var(--red);
  }

  .sign-out:disabled {
    cursor: default;
    opacity: 0.6;
  }

  .login {
    justify-self: center;
    padding: 0.4375rem 1.5rem;
    font: var(--text-sm) / 1.5 var(--label);
    letter-spacing: 0.2em;
    color: var(--paper);
    background: var(--ink);
  }

  @media (width <= 48rem) {
    .toolbar {
      gap: 0.5rem;
    }

    .toolbar :global(.circle) {
      inline-size: 2rem;
      block-size: 2rem;
    }

    /* 头像是三个里最左边那个：面板右边对齐到最右边那个圆 */
    .panel {
      --shift-x: 0px;

      inset-inline-start: auto;
      inset-inline-end: calc(-2 * (2rem + 0.5rem));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-gear]:hover svg {
      rotate: none;
    }
  }
</style>
