---
import type { WidgetViewProps } from '../../core/widget';
import Live from './Live.astro';
import type { WeatherOptions } from './widget';

type Props = WidgetViewProps<WeatherOptions>;

const { id, options } = Astro.props;
---

<div class="weather">
  {
    options.label && (
      <p class="place">
        {options.label}
        <span class="visually-hidden">天气</span>
      </p>
    )
  }
  <Live server:defer id={id}>
    <Fragment slot="fallback">
      <span class="temp skeleton" aria-hidden="true"></span>
      <span class="condition skeleton" aria-hidden="true"></span>
      <span class="range skeleton" aria-hidden="true"></span>
      <span class="visually-hidden">天气加载中</span>
    </Fragment>
  </Live>
</div>

<style>
  /*
   * 地名在最上面；左边一个大号气温，右边三行：天气、最高 / 最低、湿度和降水。
   * Live.astro 的内容用 :global 选中；每一项都写明所在的行列，岛屿到达前后位置不变
   */
  .weather {
    display: grid;
    grid-template-columns: auto auto;
    column-gap: 0.875rem;
  }

  .place {
    grid-column: 1 / -1;
    margin-block-end: 0.25rem;
    font: var(--text-sm) / 1.3 var(--label);
    letter-spacing: 0.2em;
    color: var(--ink-2);
  }

  .weather :global(.temp) {
    grid-row: 2 / span 3;
    grid-column: 1;
    font: 400 3.375rem / 1 var(--serif);
  }

  .weather :global(.condition) {
    grid-row: 2;
    grid-column: 2;
    font-size: var(--text-md);
    font-weight: 700;
  }

  .weather :global(.range) {
    grid-row: 3;
    grid-column: 2;
  }

  .weather :global(.meta) {
    grid-row: 4;
    grid-column: 2;
  }

  .weather :global(.range),
  .weather :global(.meta) {
    font: var(--text-xs) / 1.5 var(--num);
    color: var(--ink-2);
  }

  .weather :global(.unavailable) {
    grid-column: 1 / -1;
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  /* 骨架：island 到达前占住气温和两行说明的位置，不做闪烁动画 */
  .skeleton {
    display: block;
    background: var(--skeleton);
  }

  .temp.skeleton {
    inline-size: 4.25rem;
    block-size: 3.375rem;
  }

  .condition.skeleton {
    inline-size: 2.5rem;
    block-size: 0.9375rem;
    margin-block: 0.125rem;
  }

  .range.skeleton {
    inline-size: 4.5rem;
    block-size: 0.75rem;
    margin-block: 0.1875rem;
  }

  @media (width <= 48rem) {
    .weather :global(.temp) {
      font-size: 2.625rem;
    }

    .temp.skeleton {
      inline-size: 3.25rem;
      block-size: 2.625rem;
    }

    /* 手机上页头只留气温、天气和最高 / 最低 */
    .weather :global(.meta) {
      display: none;
    }
  }
</style>
