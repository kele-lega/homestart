---
import type { SiteConfig } from '../core/site';
import InkLayout from '../ink/InkLayout.astro';
import { cnMonth, cnNumber } from '../ink/text';
import { localDateKey, weekdayOf } from '../lib/zoned-time';
import SettingsLink from '../zones/SettingsLink.astro';
import ThemeSwitch from '../zones/ThemeSwitch.astro';
import '../styles/leaf.css';
import '../ink/leaf.css';
import '../ink/scroll.css';

/**
 * 首页以外的几页（登录、注册、找回密码、个人中心、设置）：同一张宣纸，左上角「归 首页」，右上角明暗和设置，
 * 题头是站名和今天的日期。卡片、输入框、按钮的类名仍是 styles/leaf.css 的 leaf-*，留白的样子在 ink/leaf.css
 */
interface Props {
  readonly site: SiteConfig;
  /** 标签页标题里站名前面那一段 */
  readonly heading: string;
  /** 纸上内容的宽度：登录只要一张窄卡片，个人中心宽一些 */
  readonly width?: 'narrow' | 'wide';
  /** 鼠标点纸上的空白处回首页（设置、个人中心；登录这类填表的页不要，点偏了会丢掉填了一半的东西） */
  readonly blankHome?: boolean;
}

const WEEKDAYS = ['日', '一', '二', '三', '四', '五', '六'];
const { site, heading, width = 'narrow', blankHome = false } = Astro.props;
const today = localDateKey(Date.now(), site.timezone);
const [, month = 1, day = 1] = today.split('-').map(Number);
---

<InkLayout site={site} title={`${heading} · ${site.title}`}>
  <div class="leaf" data-width={width} data-blank-home={blankHome ? '' : undefined}>
    <nav class="leaf-bar" aria-label="页面">
      <a class="leaf-back" href="/"><b aria-hidden="true">归</b>首页</a>
      <span class="leaf-tools">
        <ThemeSwitch />
        <SettingsLink />
      </span>
    </nav>
    <header class="leaf-masthead">
      <p class="leaf-title">{site.title}</p>
      <p class="leaf-date">
        <time datetime={today}>{cnMonth(month)}{cnNumber(day)}日</time>　星期{WEEKDAYS[weekdayOf(today)]}
      </p>
    </header>
    <main class="leaf-body">
      <slot />
    </main>
  </div>
</InkLayout>

<script>
  import '../ink/leaf-blank';
</script>
